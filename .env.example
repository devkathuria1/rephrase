# Copy to .env and fill in. Never commit .env.
# LLM_PROVIDER: groq | ollama | anthropic | none
#   none (or any provider failure) disables rephrasing; classification and
#   explainability still work.
LLM_PROVIDER=groq

# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=

# Optional Anthropic provider
ANTHROPIC_API_KEY=

# Optional local Ollama server (default http://localhost:11434)
# OLLAMA_URL=http://localhost:11434

# Model name for the chosen provider. Leave blank for the defaults:
#   groq: openai/gpt-oss-120b   ollama: llama3.1   anthropic: claude-sonnet-5-5
LLM_MODEL=
